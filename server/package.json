{
  "name": "dtest2-harmony-api",
  "version": "0.1.0",
  "private": true,
  "description": "景德镇艺术职业大学教务 App 后端 API（Track B 垂直切片：认证 / 课程 / 选课）",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "migrate": "node migrate.js",
    "seed": "node seed.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check:syntax": "node scripts/check-syntax.js",
    "smoke:live": "node scripts/smoke-live.js",
    "security:audit": "npm audit --registry=https://registry.npmjs.org/ --audit-level=low",
    "security:audit:prod": "npm audit --registry=https://registry.npmjs.org/ --omit=dev --audit-level=low"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.10",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/jest.setup.js"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/email.js",
      "!src/db.js"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "statements": 79,
        "branches": 80
      }
    }
  }
}
