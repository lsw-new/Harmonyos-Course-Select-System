# 复制为 .env 并填入真实值（.env 不入库）
PORT=8090

# 本地 Postgres（与 App 同库，dtest2 schema）
PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=dtest2_harmony
PGUSER=dtest2_app
PGPASSWORD=__REPLACE_WITH_DB_PASSWORD__

# JWT 签名密钥（请用随机长串）
JWT_SECRET=__REPLACE_WITH_RANDOM_SECRET__

# 邮件发送（QQ 邮箱 SMTP：SMTP_SENDER_PASSWORD 为 QQ 邮箱「授权码」，非登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_SENDER_EMAIL=__REPLACE_WITH_SENDER_EMAIL__
SMTP_SENDER_PASSWORD=__REPLACE_WITH_SMTP_AUTH_CODE__
APP_NAME=景德镇艺术职业大学教学管理系统
