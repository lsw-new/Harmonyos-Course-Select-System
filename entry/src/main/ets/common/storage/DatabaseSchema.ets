export const DATABASE_NAME: string = 'dtest2_app.db';
export const DATABASE_VERSION: number = 1;
export const DATABASE_SCHEMA_VERSION_KEY: string = 'schema.version';

export const DATABASE_SCHEMA_SQL: string[] = [
  `CREATE TABLE IF NOT EXISTS app_meta (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
  )`,
  `CREATE TABLE IF NOT EXISTS accounts (
    account_id TEXT PRIMARY KEY,
    role TEXT NOT NULL CHECK (role IN ('student', 'admin')),
    password_hash TEXT NOT NULL,
    salt TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'active',
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
  )`,
  `CREATE TABLE IF NOT EXISTS student_profiles (
    student_id TEXT PRIMARY KEY,
    account_id TEXT,
    name TEXT NOT NULL,
    gender TEXT,
    college TEXT NOT NULL,
    major TEXT NOT NULL,
    class_name TEXT NOT NULL,
    grade TEXT NOT NULL,
    phone TEXT,
    email TEXT,
    address TEXT,
    emergency_contact TEXT,
    avatar_url TEXT,
    bio TEXT,
    status TEXT NOT NULL DEFAULT 'active',
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (account_id) REFERENCES accounts(account_id)
  )`,
  `CREATE TABLE IF NOT EXISTS admin_profiles (
    admin_id TEXT PRIMARY KEY,
    account_id TEXT,
    name TEXT NOT NULL,
    department TEXT NOT NULL,
    role_id TEXT,
    status TEXT NOT NULL DEFAULT 'online',
    avatar_url TEXT,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (account_id) REFERENCES accounts(account_id)
  )`,
  `CREATE TABLE IF NOT EXISTS roles (
    role_id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
  )`,
  `CREATE TABLE IF NOT EXISTS permissions (
    permission_id TEXT PRIMARY KEY,
    code TEXT NOT NULL,
    action TEXT NOT NULL,
    module TEXT NOT NULL,
    name TEXT,
    UNIQUE (code, action)
  )`,
  `CREATE TABLE IF NOT EXISTS role_permissions (
    role_id TEXT NOT NULL,
    code TEXT NOT NULL,
    action TEXT NOT NULL,
    PRIMARY KEY (role_id, code, action),
    FOREIGN KEY (role_id) REFERENCES roles(role_id)
  )`,
  `CREATE TABLE IF NOT EXISTS courses (
    course_id TEXT PRIMARY KEY,
    code TEXT NOT NULL UNIQUE,
    teaching_class_no TEXT,
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    credit REAL NOT NULL,
    teacher TEXT NOT NULL,
    college TEXT,
    campus TEXT,
    classroom TEXT,
    weeks TEXT,
    period_start INTEGER,
    period_end INTEGER,
    weekday INTEGER,
    capacity INTEGER NOT NULL DEFAULT 0,
    status TEXT NOT NULL DEFAULT 'draft',
    description TEXT,
    assessment_json TEXT,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
  )`,
  `CREATE TABLE IF NOT EXISTS schedule_items (
    id TEXT PRIMARY KEY,
    student_id TEXT NOT NULL,
    term TEXT NOT NULL,
    course_id TEXT NOT NULL,
    course_name TEXT NOT NULL,
    teacher TEXT,
    weekday INTEGER NOT NULL,
    period_start INTEGER NOT NULL,
    period_end INTEGER NOT NULL,
    start_time TEXT,
    end_time TEXT,
    classroom TEXT,
    campus TEXT,
    weeks_json TEXT NOT NULL,
    week_text TEXT,
    course_type TEXT,
    FOREIGN KEY (student_id) REFERENCES student_profiles(student_id),
    FOREIGN KEY (course_id) REFERENCES courses(course_id)
  )`,
  `CREATE TABLE IF NOT EXISTS selection_rounds (
    round_id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    start_time TEXT NOT NULL,
    end_time TEXT NOT NULL,
    status TEXT NOT NULL,
    progress_percent REAL NOT NULL DEFAULT 0,
    participant_count INTEGER NOT NULL DEFAULT 0,
    selection_count INTEGER NOT NULL DEFAULT 0,
    average_credit REAL NOT NULL DEFAULT 0,
    conflict_count INTEGER NOT NULL DEFAULT 0,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
  )`,
  `CREATE TABLE IF NOT EXISTS selections (
    id TEXT PRIMARY KEY,
    student_id TEXT NOT NULL,
    course_id TEXT NOT NULL,
    round_id TEXT,
    status TEXT NOT NULL DEFAULT 'selected',
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (student_id, course_id),
    FOREIGN KEY (student_id) REFERENCES student_profiles(student_id),
    FOREIGN KEY (course_id) REFERENCES courses(course_id),
    FOREIGN KEY (round_id) REFERENCES selection_rounds(round_id)
  )`,
  `CREATE TABLE IF NOT EXISTS notices (
    notice_id TEXT PRIMARY KEY,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    summary TEXT,
    publisher_id TEXT,
    publisher_name TEXT,
    category TEXT NOT NULL,
    urgency TEXT NOT NULL DEFAULT 'normal',
    receiver_type TEXT NOT NULL DEFAULT 'all',
