    published_at TEXT,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (student_id) REFERENCES student_profiles(student_id),
    FOREIGN KEY (course_id) REFERENCES courses(course_id)
  )`,
  `CREATE TABLE IF NOT EXISTS evaluation_templates (
    template_id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT,
    question_count INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT 'enabled',
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
  )`,
  `CREATE TABLE IF NOT EXISTS evaluation_tasks (
    task_id TEXT PRIMARY KEY,
    template_id TEXT NOT NULL,
    term TEXT NOT NULL,
    course_id TEXT,
    start_time TEXT,
    end_time TEXT,
    status TEXT NOT NULL DEFAULT 'draft',
    FOREIGN KEY (template_id) REFERENCES evaluation_templates(template_id),
    FOREIGN KEY (course_id) REFERENCES courses(course_id)
  )`,
  `CREATE TABLE IF NOT EXISTS evaluation_submissions (
    submission_id TEXT PRIMARY KEY,
    task_id TEXT NOT NULL,
    student_id TEXT NOT NULL,
    answers_json TEXT NOT NULL,
    submitted_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (task_id, student_id),
    FOREIGN KEY (task_id) REFERENCES evaluation_tasks(task_id),
    FOREIGN KEY (student_id) REFERENCES student_profiles(student_id)
  )`,
  `CREATE TABLE IF NOT EXISTS practice_projects (
    project_id TEXT PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT,
    status TEXT NOT NULL DEFAULT 'available',
    start_date TEXT,
    end_date TEXT,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
  )`,
  `CREATE TABLE IF NOT EXISTS practice_signups (
    signup_id TEXT PRIMARY KEY,
    project_id TEXT NOT NULL,
    student_id TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'submitted',
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (project_id, student_id),
    FOREIGN KEY (project_id) REFERENCES practice_projects(project_id),
    FOREIGN KEY (student_id) REFERENCES student_profiles(student_id)
  )`,
  `CREATE TABLE IF NOT EXISTS feedback_items (
    feedback_id TEXT PRIMARY KEY,
    student_id TEXT,
    category TEXT NOT NULL,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    contact TEXT,
    screenshots_json TEXT,
